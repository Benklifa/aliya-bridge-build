{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.aliyafinancial.com"
        }
      ],
      "destination": "https://aliyafinancial.com/$1",
      "permanent": true
    },
    {
      "source": "/website-privacy",
      "destination": "/privacy#website",
      "permanent": true
    },
    {
      "source": "/form-crs.html",
      "destination": "/disclosures",
      "permanent": true
    },
    {
      "source": "/form-crs",
      "destination": "/disclosures",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
